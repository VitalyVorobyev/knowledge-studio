{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PackInspect Knowledge Studio",
  "version": "0.1.0",
  "identifier": "studio.packinspect.synthetic",
  "build": {
    "beforeDevCommand": "npm run web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PackInspect Knowledge Studio \u00b7 Synthetic workspace",
        "width": 1440,
        "height": 940,
        "minWidth": 1000,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Synthetic Git-native engineering knowledge workbench",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
